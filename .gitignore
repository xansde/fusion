# Material de terceiros com copyright — nunca enviar a repositório remoto
docs/etmos-fontes/

# Dependências e build
node_modules/
dist/
dist-release/
build/
coverage/

# Defensive: never commit compiled artefacts that land in src/ by mistake
# (happens when tsc is run without -p pointing to the package tsconfig)
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
packages/*/src/**/*.map
systems/*/src/**/*.js
systems/*/src/**/*.d.ts
systems/*/src/**/*.map

# Exception: hand-written ambient declarations, not build output
!packages/client/src/global.d.ts

# Ambiente e segredos
.env
.env.*

# Artefatos locais
*.log
.DS_Store
Thumbs.db

# Data-dir descartável de auditoria (cópia do mundo real; nunca commitar)
.fusion-build/r14-audit-data/
.fusion-build/r14-verify-data/

# Claude agent worktrees
.claude/worktrees/

# Claude session-local launch config (absolute local paths)
.claude/launch.json
.playwright-cli/

# Leva noturna 2026-08-17: ferramental local + cópia de dados (auth_secret, mundos) — nunca versionar
.fusion-build/leva-2026-08-17/
