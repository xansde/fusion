# Tool output — written by the importer/translator, never edited by hand.
# Formatting generated JSON has no reader and produces an enormous diff on every
# reimport, so these are checked by CONTENT (packs-validation.test.ts, the
# translate-packs QA) and never by indentation. `importer-pf2e/out` was already
# here; the rest was the same kind of output left uncovered, which is why the
# Format check stayed red on build/app (issue #68).
tools/importer-pf2e/out/**
tools/importer-pf2e/analysis/**
tools/importer-pf2e/samples/**
tools/translate-packs/out/**
systems/pf2e/packs/**

# Build-round records (evidence dumps, sweep reports): written once, kept as
# history — reformatting them would rewrite the record.
.fusion-build/**

# Third-party dice-box assets: rewritten by the package's postinstall on every
# install, so formatting them makes the format check non-deterministic (green
# locally, red on CI right after a fresh install).
public/assets/**
packages/client/public/dice-assets/**

# Importer/translator output and build scratch: regenerated by the tools on
# every run, for the same reason as `tools/importer-pf2e/out/**` above.
# Formatting them buries real diffs under hundreds of regenerated files and
# makes the check flip red whenever a pack is rebuilt.
systems/pf2e/packs/**
tools/translate-packs/out/**
tools/importer-pf2e/samples/**
tools/importer-pf2e/analysis/**
.fusion-build/**
.esteira/**
