{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "paths": {
      // etmos resolves dependencies via built declaration files (.d.ts).
      // pnpm build -r guarantees topological order: shared → system-api → system-etmos
      "@fusion/system-api": ["../../packages/system-api/dist/index.d.ts"],
      "@fusion/shared": ["../../packages/shared/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/__tests__/**", "dist"]
}
