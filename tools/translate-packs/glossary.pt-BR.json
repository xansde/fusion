  "styleDecisions": {
    "DC->CD": "Traduzido consistentemente para CD (Classe de Dificuldade). NUNCA manter 'DC' na prosa pt-BR. Aplicado tanto em `terms` quanto nos compostos (spell DC, class DC, level DC).",
    "off-guard": "Condicao remaster 'Off-Guard' -> 'Desprevenido' (era flat-footed no legado; usamos a semantica remaster).",
    "vitality/void": "Tipos de dano remaster (ex-positivo/negativo): 'vitality'->'vitalidade', 'void'->'vazio'.",
    "holy/unholy vs good/evil": "Traits remaster de sanctidade 'holy'/'unholy' -> 'sagrado'/'profano'. Os traits legados de alinhamento 'good'/'evil' ainda ocorrem nos packs e viram 'benigno'/'maligno' (distintos de sagrado/profano).",
    "flat check": "'teste simples' (sem modificador; contra CD fixa) — distinto de 'saving throw'='teste de resistencia'.",
    "reach (weapon vs melee)": "Como trait de arma, 'reach'->'alcance'. Na prosa de combate ('increases your reach') usamos 'alcance natural' (`terms.reach`) para nao colidir com 'range'=alcance de magia/arma a distancia.",
    "Strike": "Acao basica de ataque -> 'Golpe' (maiuscula quando referida como a acao nomeada).",
    "skill vs Lore": "'skill' (trait/pericia generica) -> 'pericia'; a pericia especifica 'Lore' -> 'Conhecimento'.",
    "bulk": "'bulk' (unidade de peso do PF2e) -> 'volume'.",
    "ratfolk": "trait 'ratfolk' -> 'ratkin' (traducao generica propria; a ancestralidade em si e nome cunhado).",
    "weakness": "'weakness' (mecanica de vulnerabilidade a tipo de dano) -> 'vulnerabilidade' para nao colidir semanticamente com fraqueza generica.",
    "encounter": "'encounter' -> 'combate' no contexto de modo de jogo/rodada; o trait de modo 'exploration'/'downtime' seguem 'exploracao'/'tempo livre'.",
    "oath": "Trait de talentos do Campeão (ex.: 'Oath of the Avenger', 'Vengeful Oath') -> 'voto'. Nenhum trait 'vow' concorrente existe nos packs atuais; se for introduzido, revisar para nao colidir.",
    "consecration": "Trait de talentos do Clerigo ligados a consagrar terreno/objetos (ex.: 'Sacred Ground') -> 'consagracao', alinhado a 'sanctified'->'santificado' e 'holy'->'sagrado' no mesmo campo semantico religioso."
  }
}
