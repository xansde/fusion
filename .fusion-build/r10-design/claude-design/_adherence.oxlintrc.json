{
  "plugins": ["react", "import"],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/character/**",
              "components/forms/**",
              "components/layout/**",
              "components/navigation/**",
              "components/plan/**",
              "components/spells/**",
              "ui_kits/ficha-pf2e/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Cascadia Code|Source Code Pro))/i]",
        "message": "Font not provided by the design system. Available: Cascadia Code, Source Code Pro."
      },
      {
        "selector": "JSXOpeningElement[name.name='ABCCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:typeLabel|name|subLine|done|style|key|ref|className|style|children)$/]",
        "message": "<ABCCard> doesn't accept that prop. Declared props: typeLabel, name, subLine, done, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ACShield'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|width|height|style|key|ref|className|style|children)$/]",
        "message": "<ACShield> doesn't accept that prop. Declared props: value, label, width, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|fullWidth|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, fullWidth, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|subtle|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'subtle' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:tiny|sm|md|lg)$/]",
        "message": "<Button> size must be one of 'tiny' | 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|active|fixed|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: children, active, fixed, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slot'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|type|badge|onRemove|style|key|ref|className|style|children)$/]",
        "message": "<Slot> doesn't accept that prop. Declared props: name, type, badge, onRemove, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|onClose|footerNote|footer|width|maxHeight|children|style|key|ref|className|style|children)$/]",
        "message": "<Modal> doesn't accept that prop. Declared props: title, onClose, footerNote, footer, width, maxHeight, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ModeToggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|defaultValue|onChange|style|key|ref|className|style|children)$/]",
        "message": "<ModeToggle> doesn't accept that prop. Declared props: options, value, defaultValue, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|actions|padding|children|style|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: title, actions, padding, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pip'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|size|title|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Pip> doesn't accept that prop. Declared props: state, size, title, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pip'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:filled|empty|locked)$/]",
        "message": "<Pip> state must be one of 'filled' | 'empty' | 'locked'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProficiencyBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:rank|variant|size|title|style|key|ref|className|style|children)$/]",
        "message": "<ProficiencyBadge> doesn't accept that prop. Declared props: rank, variant, size, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProficiencyBadge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:outline|filled)$/]",
        "message": "<ProficiencyBadge> variant must be one of 'outline' | 'filled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ResultRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:rank|actionCost|name|traits|source|selected|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ResultRow> doesn't accept that prop. Declared props: rank, actionCost, name, traits, source, selected, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchBox'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|style|key|ref|className|style|children)$/]",
        "message": "<SearchBox> doesn't accept that prop. Declared props: placeholder, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SkillRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:rank|name|modifier|onRoll|style|key|ref|className|style|children)$/]",
        "message": "<SkillRow> doesn't accept that prop. Declared props: rank, name, modifier, onRoll, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpellSlotCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|available|onCast|onSwap|style|key|ref|className|style|children)$/]",
        "message": "<SpellSlotCard> doesn't accept that prop. Declared props: name, available, onCast, onSwap, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|minWidth|interactive|style|key|ref|className|style|children)$/]",
        "message": "<StatChip> doesn't accept that prop. Declared props: label, value, minWidth, interactive, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|key|ref|className|style|children)$/]",
        "message": "<TabItem> doesn't accept that prop. Declared props: id, label."
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/index.js"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
